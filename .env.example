# =====================================================================
# Chatbot académico UNAB - plantilla de variables de entorno
# 1. Copia este archivo como .env
# 2. Completa los valores reales
# El archivo .env NUNCA se sube a GitHub (está en .gitignore)
# =====================================================================

# ---------- General ----------
TZ=America/Bogota
# Valores posibles: local | aws
APP_ENV=local

# ---------- Supabase PostgreSQL ----------
# Usar los datos del "Session pooler" (IPv4) en Supabase > Connect
# Copia el host exacto que muestra Supabase (el número aws-0 o aws-1 puede variar)
SUPABASE_DB_HOST=aws-0-us-west-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
# Usuario administrador: solo para migraciones y tareas de mantenimiento
SUPABASE_DB_USER=postgres.TU_PROJECT_REF
SUPABASE_DB_PASSWORD=cambia_esto
SUPABASE_DB_SSLMODE=require

# ---------- Roles de base de datos por servicio ----------
# Creados en database/migrations/006. El usuario lleva el sufijo del proyecto.
# Las contraseñas se asignan en Supabase con secrets/roles_supabase.sql
DB_API_USER=chatbot_api.TU_PROJECT_REF
DB_API_PASSWORD=cambia_esto
DB_MCP_USER=chatbot_mcp.TU_PROJECT_REF
DB_MCP_PASSWORD=cambia_esto
DB_N8N_USER=chatbot_n8n.TU_PROJECT_REF
DB_N8N_PASSWORD=cambia_esto

# ---------- Claude (modelo de lenguaje) ----------
# API key creada en la Consola de Claude (platform.claude.com)
ANTHROPIC_API_KEY=cambia_esto
ANTHROPIC_CHAT_MODEL=claude-haiku-5-5

# ---------- Voyage AI (embeddings del RAG) ----------
# API key creada en el panel de Voyage AI
VOYAGE_API_KEY=cambia_esto
VOYAGE_EMBEDDING_MODEL=voyage-4
EMBEDDING_DIM=1024

# ---------- n8n ----------
# Cadena aleatoria larga; si se pierde, n8n no puede leer sus credenciales
N8N_ENCRYPTION_KEY=cambia_esto
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
# Secreto compartido entre FastAPI y el webhook interno de n8n
N8N_WEBHOOK_SECRET=cambia_esto

# ---------- Backend FastAPI ----------
# Secreto para firmar los tokens de sesión (lo comparten la API y el servidor MCP)
JWT_SECRET=cambia_esto
JWT_EXPIRES_MINUTES=120
JWT_ISSUER=chatbot-unab-api
JWT_AUDIENCE=chatbot-unab
N8N_INTERNAL_URL=http://n8n:5678/webhook/

# ---------- Servidor MCP ----------
MCP_PORT=9000
# Token Bearer que deben enviar n8n y los clientes MCP
MCP_AUTH_TOKEN=cambia_esto

# ---------- Scraper de noticias ----------
# Token Bearer que n8n envía al scraper (cadena aleatoria larga)
SCRAPER_TOKEN=cambia_esto

# ---------- Google Sheets ----------
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
GOOGLE_SHEET_CALENDARIO_ID=

# ---------- Despliegue en AWS ----------
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=
