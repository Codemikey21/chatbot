      "id": "32414a74-9dde-52a3-917b-c9b1fa02cbea",
      "name": "Parámetros de prueba",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normaliza la categoría y el límite que pide el agente\nconst CATEGORIAS = ['curso', 'convocatoria', 'certificacion', 'noticia'];\nconst entrada = $input.first().json;\nconst categoria = String(entrada.categoria ?? '')\n  .normalize('NFD').replace(/[̀-ͯ]/g, '')\n  .toLowerCase().trim().replace(/s$/, '');\nconst limite = Math.min(Math.max(parseInt(entrada.limite, 10) || 5, 1), 10);\n\nreturn [{ json: { categoria: CATEGORIAS.includes(categoria) ? categoria : '', limite } }];\n"
      },
      "id": "38c450a6-64ed-5861-880d-58c0db3e1b2b",
      "name": "Normalizar parámetros",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        80
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select titulo, resumen, url, categoria, fecha_publicacion, fuente\nfrom v_noticias_recientes\nwhere ($1::text = '' or categoria = $1::text)\norder by fecha_publicacion desc nulls last, recopilado_en desc\nlimit $2::int;",
        "options": {
          "queryReplacement": "={{ [$json.categoria, $json.limite] }}"
        }
      },
      "id": "dbbbf8e4-0cdc-516f-828d-5326e5040a06",
      "name": "Leer noticias recientes",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        680,
        80
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Supabase - n8n"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Entrega al agente las novedades con su fuente, enlace y fecha\nconst filas = $input.all().map((item) => item.json).filter((fila) => fila.titulo);\nconst parametros = $('Normalizar parámetros').first().json;\n\nif (filas.length === 0) {\n  return [{\n    json: {\n      encontrado: false,\n      categoria: parametros.categoria || 'todas',\n      mensaje: 'Todavía no hay noticias recopiladas para esa categoría.',\n      noticias: [],\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    encontrado: true,\n    categoria: parametros.categoria || 'todas',\n    total: filas.length,\n    noticias: filas.map((fila) => ({\n      titulo: fila.titulo,\n      resumen: fila.resumen ? String(fila.resumen).slice(0, 400) : null,\n      categoria: fila.categoria,\n      fecha_publicacion: fila.fecha_publicacion,\n      fuente: fila.fuente,\n      url: fila.url,\n    })),\n  },\n}];\n"
      },
      "id": "9166d302-dcb6-5993-b4f7-5d679b70000f",
      "name": "Preparar noticias",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        80
      ]
    }
